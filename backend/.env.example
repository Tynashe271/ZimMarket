NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://zimmarket:zimmarket@127.0.0.1:5435/zimmarket?schema=public
REDIS_HOST=localhost
REDIS_PORT=6380
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=replace-with-a-different-32-character-secret
JWT_REFRESH_TTL_DAYS=30
CORS_ORIGINS=http://localhost:3001
PAYMENT_WEBHOOK_SECRET=replace-with-payment-provider-webhook-secret
# PAYMENT_PROVIDER=development simulates payment settlement locally (see /finance/demo/payments).
# Set to "paynow" to route online payment methods through the real Paynow Zimbabwe gateway,
# which requires PAYNOW_INTEGRATION_ID and PAYNOW_INTEGRATION_KEY from https://www.paynow.co.zw.
PAYMENT_PROVIDER=development
PAYNOW_INTEGRATION_ID=
PAYNOW_INTEGRATION_KEY=
PAYNOW_FALLBACK_EMAIL=payments@zimmarket.local
STORAGE_SIGNING_SECRET=replace-with-storage-signing-secret
APP_PUBLIC_URL=http://localhost:3001
WHATSAPP_PROVIDER=development
# SMS_PROVIDER=development simulates SMS delivery locally (see /demo/outbox).
# Set to "africastalking" to send real SMS/OTP messages via Africa's Talking
# (https://africastalking.com), which requires AFRICASTALKING_API_KEY and
# AFRICASTALKING_USERNAME. Use username "sandbox" to test against their sandbox
# (sandbox never reaches a real phone; it only shows up in their Simulator).
# Set to "twilio" to send via Twilio instead, which requires TWILIO_ACCOUNT_SID,
# TWILIO_AUTH_TOKEN, and either TWILIO_MESSAGING_SERVICE_SID or TWILIO_FROM_NUMBER.
SMS_PROVIDER=development
AFRICASTALKING_API_KEY=
AFRICASTALKING_USERNAME=
AFRICASTALKING_SENDER_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM_NUMBER=
EMAIL_PROVIDER=development
MALWARE_SCANNER=development
MAPS_PROVIDER=development
ACCOUNTING_PROVIDER=internal
API_PUBLIC_URL=http://localhost:3000/api/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LOCAL_STORAGE_PATH=.data/storage
DEMO_ADMIN_EMAIL=admin@zimmarket.local
DEMO_ADMIN_PHONE=+263770000001
DEMO_ADMIN_PASSWORD=ChangeMe123!
DEMO_OWNER_EMAIL=owner@zimmarket.local
DEMO_CUSTOMER_EMAIL=customer@zimmarket.local
