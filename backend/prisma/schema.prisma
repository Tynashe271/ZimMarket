generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountType {
  CUSTOMER
  BUSINESS
  ADMIN
}

enum BusinessRole {
  OWNER
  MANAGER
  SALES
  INVENTORY
  MARKETING
  FINANCE
  SUPPORT
  DELIVERY
}

enum BusinessStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REJECTED
}

enum FiscalisationMethod {
  PHYSICAL_DEVICE
  FISCALISED_POS
  VIRTUAL_DEVICE
  FDMS_API
}

enum ComplianceStatus {
  DRAFT
  PENDING_VERIFICATION
  CHANGES_REQUIRED
  COMPLIANT
  EXPIRING_SOON
  EXPIRED
  DEVICE_INACTIVE
  SUSPENDED
  UNDER_REVIEW
  RENEWAL_PENDING
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum VerificationType {
  EMAIL
  PHONE
  PASSWORD_RESET
  MFA
}

enum DocumentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AdStatus {
  DRAFT
  PENDING_REVIEW
  ACTIVE
  PAUSED
  REJECTED
  EXPIRED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum PayoutStatus {
  PENDING
  APPROVED
  PROCESSING
  PAID
  REJECTED
}

enum ReportStatus {
  OPEN
  INVESTIGATING
  RESOLVED
  DISMISSED
}

enum AvailabilityStatus {
  AVAILABLE
  LOW_STOCK
  PREORDER
  UNAVAILABLE
}

enum RequestStatus {
  OPEN
  CLOSED
  AWARDED
  CANCELLED
}

enum QuoteStatus {
  DRAFT
  SUBMITTED
  ACCEPTED
  REJECTED
  EXPIRED
}

enum BookingStatus {
  REQUESTED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum DeliveryMethod {
  BUSINESS_DELIVERY
  INDEPENDENT_COURIER
  STORE_COLLECTION
  COLLECTION_POINT
  INTERCITY
}

enum DeliveryStatus {
  PENDING
  ASSIGNED
  COLLECTED
  IN_TRANSIT
  READY_FOR_COLLECTION
  DELIVERED
  FAILED
  CANCELLED
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  AWAITING_EVIDENCE
  RESOLVED
  REJECTED
}

enum VerificationLevel {
  BASIC
  PHONE_VERIFIED
  IDENTITY_VERIFIED
  REGISTERED_COMPANY
  DOCUMENT_VERIFIED
  VERIFIED_SERVICE_PROVIDER
}

enum ReservationStatus {
  ACTIVE
  COLLECTED
  EXPIRED
  CANCELLED
}

enum SubscriptionPlan {
  FREE
  STARTER
  BUSINESS
  PREMIUM
  ENTERPRISE
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

enum SaleChannel {
  ONLINE
  POS
}

enum RefundStatus {
  REQUESTED
  APPROVED
  PROCESSING
  REFUNDED
  REJECTED
}

enum FraudSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model User {
  id                     String              @id @default(uuid()) @db.Uuid
  email                  String?             @unique
  phone                  String              @unique
  passwordHash           String
  accountType            AccountType
  fullName               String?
  province               String?
  city                   String?
  suburb                 String?
  deliveryAddresses      Json?
  notificationPreference String              @default("EMAIL")
  policyVersion          String?
  policyAcceptedAt       DateTime?
  emailVerifiedAt        DateTime?
  phoneVerifiedAt        DateTime?
  failedLoginCount       Int                 @default(0)
  lockedUntil            DateTime?
  mfaEnabled             Boolean             @default(false)
  deletedAt              DateTime?
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
  memberships            BusinessMember[]
  orders                 Order[]
  auditEvents            AuditLog[]          @relation("AuditActor")
  sessions               Session[]
  verifications          VerificationToken[]
  documents              Document[]          @relation("DocumentOwner")
  conversations          Conversation[]      @relation("CustomerConversations")
  messages               Message[]
  reportsFiled           Report[]            @relation("ReportReporter")
  reportsAgainst         Report[]            @relation("ReportSubjectUser")
  approvedPayouts        Payout[]            @relation("PayoutApprover")
  customerRequests       CustomerRequest[]
  bookings               Booking[]
  reviews                Review[]
  disputes               Dispute[]           @relation("DisputeOpenedBy")
  loyaltyAccounts        LoyaltyAccount[]
  follows                ProductFollow[]
  reservations           Reservation[]
  recipients             Recipient[]
  supportTickets         SupportTicket[]
  searchEvents           SearchEvent[]
  fraudSignals           FraudSignal[]
  refunds                RefundRequest[]     @relation("RefundRequester")
  courierProfile         CourierProfile?
  referredCustomers      Referral[]          @relation("ReferralReferrer")
  referralClaims         Referral[]          @relation("ReferralReferred")
  birthDate              DateTime?
}

model Business {
  id                  String                @id @default(uuid()) @db.Uuid
  name                String
  slug                String                @unique
  industry            String?
  communityTags       String[]
  status              BusinessStatus        @default(PENDING)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  settings            Json?
  members             BusinessMember[]
  products            Product[]
  orders              Order[]
  documents           Document[]
  ads                 Advertisement[]
  conversations       Conversation[]
  payouts             Payout[]
  reports             Report[]
  branches            Branch[]
  customerOffers      Quote[]
  services            Service[]
  verificationLevel   VerificationLevel     @default(BASIC)
  wholesaleOffers     WholesaleOffer[]      @relation("WholesaleSeller")
  wholesaleAccess     WholesaleAccess[]     @relation("WholesaleBuyer")
  loyaltyPrograms     LoyaltyProgram[]
  subscription        BusinessSubscription?
  supportedCurrencies BusinessCurrency[]
  supportTickets      SupportTicket[]
  couriers            CourierBusiness[]
  refunds             RefundRequest[]
  fiscalisation       BusinessFiscalisation?
}

model BusinessFiscalisation {
  id                           String              @id @default(uuid()) @db.Uuid
  businessId                   String              @unique @db.Uuid
  registeredBusinessName       String
  tradingName                  String
  tin                          String
  taxpayerActive               Boolean              @default(false)
  vatNumber                    String?
  taxClearanceCertificateNumber String
  taxClearanceIssuedAt         DateTime
  taxClearanceExpiresAt        DateTime
  taxClearanceDocumentKey      String
  method                       FiscalisationMethod
  deviceIdentifier             String
  deviceModel                  String?
  deviceSerialNumber           String?
  virtualDeviceIdentifier      String?
  approvedSupplierOrIntegrator String
  zimraRegistrationEvidenceKey String
  branchInformation            Json
  sampleFiscalReceiptKey       String
  receiptVerificationCode      String
  authorisedRepresentative     String
  deviceActive                 Boolean              @default(false)
  deviceRegistered             Boolean              @default(false)
  status                       ComplianceStatus     @default(DRAFT)
  receiptVerifiedAt            DateTime?
  receiptVerificationReference String?
  reviewedById                 String?             @db.Uuid
  reviewedAt                   DateTime?
  rejectionReason              String?
  reminder30SentAt             DateTime?
  reminder14SentAt             DateTime?
  reminder7SentAt              DateTime?
  reminder3SentAt              DateTime?
  reminder1SentAt              DateTime?
  nextReviewAt                 DateTime?
  createdAt                    DateTime             @default(now())
  updatedAt                    DateTime             @updatedAt
  business                     Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  complianceDocuments           ComplianceDocument[]
  complianceChecks              ComplianceCheck[]
  complianceReminders           ComplianceReminder[]
  storeRestrictions            StoreRestriction[]
  complianceAuditLogs           ComplianceAuditLog[]

  @@index([status, taxClearanceExpiresAt])
  @@index([taxpayerActive, deviceActive])
  @@index([nextReviewAt])
}

model ComplianceDocument {
  id                String   @id @default(uuid()) @db.Uuid
  fiscalisationId   String   @db.Uuid
  documentType      String   // TAX_CLEARANCE, ZIMRA_REGISTRATION, FISCAL_DEVICE, VAT_REGISTRATION, SECTOR_LICENCE
  storageKey        String
  fileName          String
  mimeType          String
  sizeBytes         Int
  uploadedAt        DateTime @default(now())
  verifiedAt        DateTime?
  verificationStatus String  @default("PENDING") // PENDING, VERIFIED, REJECTED
  verifiedById      String?  @db.Uuid
  rejectionReason   String?
  fiscalisation     BusinessFiscalisation @relation(fields: [fiscalisationId], references: [id], onDelete: Cascade)

  @@index([fiscalisationId, documentType])
  @@index([verificationStatus])
}

model ComplianceCheck {
  id                String   @id @default(uuid()) @db.Uuid
  fiscalisationId   String   @db.Uuid
  checkType         String   // TAXPAYER_STATUS, DEVICE_STATUS, CERTIFICATE_VALIDITY, RECEIPT_VERIFICATION
  checkMethod       String   // AUTOMATED_API, MANUAL_ADMIN, RECEIPT_VALIDATION
  checkResult       String   // PASSED, FAILED, PENDING, INCONCLUSIVE
  checkedAt         DateTime @default(now())
  checkedById       String?  @db.Uuid
  apiResponse       Json?
  adminNotes        String?
  nextRetryAt       DateTime?
  fiscalisation     BusinessFiscalisation @relation(fields: [fiscalisationId], references: [id], onDelete: Cascade)

  @@index([fiscalisationId, checkType])
  @@index([checkResult, checkedAt])
}

model ComplianceReminder {
  id                String   @id @default(uuid()) @db.Uuid
  fiscalisationId   String   @db.Uuid
  reminderType      String   // EXPIRY_30_DAYS, EXPIRY_14_DAYS, EXPIRY_7_DAYS, EXPIRY_3_DAYS, EXPIRY_1_DAY, EXPIRY_TODAY
  scheduledFor      DateTime
  sentAt            DateTime?
  deliveryMethod    String   // DASHBOARD, EMAIL, SMS, PUSH, WHATSAPP
  deliveryStatus    String   @default("PENDING") // PENDING, SENT, FAILED
  message           String
  recipientEmail    String?
  recipientPhone    String?
  fiscalisation     BusinessFiscalisation @relation(fields: [fiscalisationId], references: [id], onDelete: Cascade)

  @@index([fiscalisationId, scheduledFor])
  @@index([deliveryStatus, scheduledFor])
}

model StoreRestriction {
  id                String   @id @default(uuid()) @db.Uuid
  fiscalisationId   String   @db.Uuid
  restrictionType   String   // NEW_PRODUCTS, NEW_SERVICES, NEW_ADS, NEW_ORDERS, NEW_BOOKINGS, PAYMENTS, PAYOUTS
  isRestricted      Boolean  @default(true)
  reason            String
  imposedAt         DateTime @default(now())
  imposedById       String?  @db.Uuid
  liftedAt          DateTime?
  liftedById        String?  @db.Uuid
  fiscalisation     BusinessFiscalisation @relation(fields: [fiscalisationId], references: [id], onDelete: Cascade)

  @@index([fiscalisationId, restrictionType])
  @@index([isRestricted])
}

model ComplianceAuditLog {
  id                String   @id @default(uuid()) @db.Uuid
  fiscalisationId   String   @db.Uuid
  action            String   // SUBMITTED, VERIFIED, REJECTED, STATUS_CHANGED, DOCUMENT_UPLOADED, RESTRICTION_IMPOSED, RESTRICTION_LIFTED, REMINDER_SENT
  actorId           String   @db.Uuid
  actorType         String   // BUSINESS_OWNER, ADMIN, SYSTEM
  previousStatus    String?
  newStatus         String?
  details           Json?
  ipAddress         String?
  userAgent         String?
  timestamp         DateTime @default(now())
  fiscalisation     BusinessFiscalisation @relation(fields: [fiscalisationId], references: [id], onDelete: Cascade)

  @@index([fiscalisationId, timestamp])
  @@index([action, timestamp])
  @@index([actorId, timestamp])
}

model BusinessMember {
  id         String        @id @default(uuid()) @db.Uuid
  userId     String        @db.Uuid
  businessId String        @db.Uuid
  role       BusinessRole
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  business   Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branches   BranchStaff[]

  @@unique([userId, businessId])
  @@index([businessId, role])
}

model Product {
  id              String            @id @default(uuid()) @db.Uuid
  businessId      String            @db.Uuid
  name            String
  slug            String
  description     String?
  price           Decimal           @db.Decimal(12, 2)
  costPrice       Decimal?          @db.Decimal(12, 2)
  stockQuantity   Int               @default(0)
  status          ProductStatus     @default(DRAFT)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  business        Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  orderItems      OrderItem[]
  advertisements  Advertisement[]
  branchInventory BranchInventory[]
  quoteItems      QuoteItem[]
  follows         ProductFollow[]
  reservations    Reservation[]
  prices          ProductPrice[]
  saleItems       SaleItem[]

  @@unique([businessId, slug])
  @@index([businessId, status])
}

model Order {
  id             String          @id @default(uuid()) @db.Uuid
  businessId     String          @db.Uuid
  branchId       String?         @db.Uuid
  customerId     String          @db.Uuid
  status         OrderStatus     @default(PENDING)
  total          Decimal         @db.Decimal(12, 2)
  currency       String          @default("USD") @db.Char(3)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  business       Business        @relation(fields: [businessId], references: [id])
  branch         Branch?         @relation(fields: [branchId], references: [id])
  customer       User            @relation(fields: [customerId], references: [id])
  items          OrderItem[]
  payments       Payment[]
  conversation   Conversation?
  delivery       Delivery?
  recipient      Recipient?
  invoice        Invoice?
  review         Review?
  dispute        Dispute?
  refundRequests RefundRequest[]

  @@index([businessId, createdAt])
  @@index([customerId, createdAt])
}

model OrderItem {
  id          String  @id @default(uuid()) @db.Uuid
  orderId     String  @db.Uuid
  productId   String  @db.Uuid
  productName String
  unitPrice   Decimal @db.Decimal(12, 2)
  quantity    Int
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product @relation(fields: [productId], references: [id])
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @db.Uuid
  action     String
  resource   String
  resourceId String?
  businessId String?  @db.Uuid
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id])

  @@index([businessId, createdAt])
  @@index([actorId, createdAt])
}

model Session {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @db.Uuid
  refreshTokenHash String
  deviceName       String?
  ipAddress        String?
  userAgent        String?
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
}

model VerificationToken {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @db.Uuid
  type      VerificationType
  tokenHash String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type, expiresAt])
}

model Document {
  id         String         @id @default(uuid()) @db.Uuid
  ownerId    String         @db.Uuid
  businessId String?        @db.Uuid
  type       String
  storageKey String         @unique
  mimeType   String
  sizeBytes  Int
  status     DocumentStatus @default(PENDING)
  reviewedAt DateTime?
  createdAt  DateTime       @default(now())
  owner      User           @relation("DocumentOwner", fields: [ownerId], references: [id])
  business   Business?      @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, status])
}

model Advertisement {
  id         String    @id @default(uuid()) @db.Uuid
  businessId String    @db.Uuid
  productId  String    @db.Uuid
  title      String
  status     AdStatus  @default(DRAFT)
  startsAt   DateTime?
  endsAt     DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  product    Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([status, startsAt, endsAt])
  @@index([businessId, status])
}

model Conversation {
  id          String    @id @default(uuid()) @db.Uuid
  businessId  String    @db.Uuid
  customerId  String    @db.Uuid
  orderId     String?   @unique @db.Uuid
  escalatedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  business    Business  @relation(fields: [businessId], references: [id])
  customer    User      @relation("CustomerConversations", fields: [customerId], references: [id])
  order       Order?    @relation(fields: [orderId], references: [id])
  messages    Message[]

  @@index([businessId, updatedAt])
  @@index([customerId, updatedAt])
  @@index([escalatedAt, updatedAt])
}

model Message {
  id             String       @id @default(uuid()) @db.Uuid
  conversationId String       @db.Uuid
  senderId       String       @db.Uuid
  body           String
  attachmentKey  String?
  createdAt      DateTime     @default(now())
  deletedAt      DateTime?
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation(fields: [senderId], references: [id])

  @@index([conversationId, createdAt])
}

model Payment {
  id             String        @id @default(uuid()) @db.Uuid
  orderId        String        @db.Uuid
  provider       String
  providerRef    String?       @unique
  idempotencyKey String        @unique
  amount         Decimal       @db.Decimal(12, 2)
  currency       String        @db.Char(3)
  status         PaymentStatus @default(PENDING)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  order          Order         @relation(fields: [orderId], references: [id])
  ledgerEntries  LedgerEntry[]
}

model LedgerEntry {
  id          String   @id @default(uuid()) @db.Uuid
  paymentId   String?  @db.Uuid
  businessId  String?  @db.Uuid
  account     String
  direction   String
  amount      Decimal  @db.Decimal(12, 2)
  currency    String   @db.Char(3)
  description String
  createdAt   DateTime @default(now())
  payment     Payment? @relation(fields: [paymentId], references: [id])

  @@index([businessId, createdAt])
}

model Payout {
  id           String       @id @default(uuid()) @db.Uuid
  businessId   String       @db.Uuid
  amount       Decimal      @db.Decimal(12, 2)
  currency     String       @db.Char(3)
  destination  String
  status       PayoutStatus @default(PENDING)
  approvedById String?      @db.Uuid
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  business     Business     @relation(fields: [businessId], references: [id])
  approvedBy   User?        @relation("PayoutApprover", fields: [approvedById], references: [id])

  @@index([businessId, status])
}

model Report {
  id            String       @id @default(uuid()) @db.Uuid
  reporterId    String       @db.Uuid
  subjectUserId String?      @db.Uuid
  businessId    String?      @db.Uuid
  reason        String
  details       String?
  status        ReportStatus @default(OPEN)
  createdAt     DateTime     @default(now())
  reporter      User         @relation("ReportReporter", fields: [reporterId], references: [id])
  subjectUser   User?        @relation("ReportSubjectUser", fields: [subjectUserId], references: [id])
  business      Business?    @relation(fields: [businessId], references: [id])

  @@index([status, createdAt])
}

model Branch {
  id             String            @id @default(uuid()) @db.Uuid
  businessId     String            @db.Uuid
  name           String
  province       String
  city           String
  suburb         String?
  latitude       Decimal?          @db.Decimal(10, 7)
  longitude      Decimal?          @db.Decimal(10, 7)
  operatingHours Json?
  deliveryAreas  String[]
  createdAt      DateTime          @default(now())
  business       Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  inventory      BranchInventory[]
  staff          BranchStaff[]
  sales          Sale[]
  bookings       Booking[]
  reservations   Reservation[]
  deliveries     Delivery[]
  orders         Order[]

  @@unique([businessId, name])
  @@index([province, city])
}

model BranchStaff {
  id           String         @id @default(uuid()) @db.Uuid
  branchId     String         @db.Uuid
  membershipId String         @db.Uuid
  branch       Branch         @relation(fields: [branchId], references: [id], onDelete: Cascade)
  membership   BusinessMember @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@unique([branchId, membershipId])
}

model BranchInventory {
  id               String             @id @default(uuid()) @db.Uuid
  branchId         String             @db.Uuid
  productId        String             @db.Uuid
  quantity         Int                @default(0)
  reserved         Int                @default(0)
  lowStockAt       Int                @default(5)
  availability     AvailabilityStatus @default(AVAILABLE)
  discloseQuantity Boolean            @default(false)
  updatedAt        DateTime           @updatedAt
  branch           Branch             @relation(fields: [branchId], references: [id], onDelete: Cascade)
  product          Product            @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([branchId, productId])
}

model Sale {
  id            String      @id @default(uuid()) @db.Uuid
  branchId      String      @db.Uuid
  staffUserId   String      @db.Uuid
  channel       SaleChannel @default(POS)
  paymentMethod String
  total         Decimal     @db.Decimal(12, 2)
  currency      String      @db.Char(3)
  returnedAt    DateTime?
  createdAt     DateTime    @default(now())
  branch        Branch      @relation(fields: [branchId], references: [id])
  items         SaleItem[]

  @@index([branchId, createdAt])
}

model SaleItem {
  id          String  @id @default(uuid()) @db.Uuid
  saleId      String  @db.Uuid
  productId   String  @db.Uuid
  productName String
  unitPrice   Decimal @db.Decimal(12, 2)
  quantity    Int
  sale        Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product     Product @relation(fields: [productId], references: [id])
}

model CustomerRequest {
  id         String        @id @default(uuid()) @db.Uuid
  customerId String        @db.Uuid
  title      String
  details    String
  category   String
  city       String?
  province   String?
  budget     Decimal?      @db.Decimal(12, 2)
  currency   String?       @db.Char(3)
  quantity   Int?
  status     RequestStatus @default(OPEN)
  expiresAt  DateTime?
  createdAt  DateTime      @default(now())
  customer   User          @relation(fields: [customerId], references: [id])
  quotes     Quote[]

  @@index([category, city, status])
}

model Quote {
  id         String          @id @default(uuid()) @db.Uuid
  requestId  String          @db.Uuid
  businessId String          @db.Uuid
  amount     Decimal         @db.Decimal(12, 2)
  currency   String          @db.Char(3)
  message    String?
  validUntil DateTime
  status     QuoteStatus     @default(SUBMITTED)
  createdAt  DateTime        @default(now())
  request    CustomerRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  business   Business        @relation(fields: [businessId], references: [id])
  items      QuoteItem[]

  @@unique([requestId, businessId])
}

model QuoteItem {
  id          String   @id @default(uuid()) @db.Uuid
  quoteId     String   @db.Uuid
  productId   String?  @db.Uuid
  description String
  quantity    Int
  unitPrice   Decimal  @db.Decimal(12, 2)
  quote       Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  product     Product? @relation(fields: [productId], references: [id])
}

model Service {
  id              String    @id @default(uuid()) @db.Uuid
  businessId      String    @db.Uuid
  name            String
  category        String
  description     String?
  durationMinutes Int
  price           Decimal?  @db.Decimal(12, 2)
  currency        String?   @db.Char(3)
  active          Boolean   @default(true)
  business        Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  bookings        Booking[]
}

model Booking {
  id            String        @id @default(uuid()) @db.Uuid
  serviceId     String        @db.Uuid
  customerId    String        @db.Uuid
  branchId      String?       @db.Uuid
  startsAt      DateTime
  endsAt        DateTime
  status        BookingStatus @default(REQUESTED)
  customerNotes String?
  createdAt     DateTime      @default(now())
  service       Service       @relation(fields: [serviceId], references: [id])
  customer      User          @relation(fields: [customerId], references: [id])
  branch        Branch?       @relation(fields: [branchId], references: [id])

  @@index([serviceId, startsAt, endsAt])
}

model Delivery {
  id                 String              @id @default(uuid()) @db.Uuid
  orderId            String              @unique @db.Uuid
  branchId           String?             @db.Uuid
  method             DeliveryMethod
  providerName       String?
  trackingCode       String?             @unique
  status             DeliveryStatus      @default(PENDING)
  recipientName      String
  recipientPhone     String
  address            String?
  city               String
  expectedAt         DateTime?
  deliveredAt        DateTime?
  order              Order               @relation(fields: [orderId], references: [id])
  branch             Branch?             @relation(fields: [branchId], references: [id])
  courierAssignments CourierAssignment[]
}

model Review {
  id          String    @id @default(uuid()) @db.Uuid
  orderId     String    @unique @db.Uuid
  customerId  String    @db.Uuid
  businessId  String    @db.Uuid
  rating      Int
  comment     String?
  moderatedAt DateTime?
  hidden      Boolean   @default(false)
  createdAt   DateTime  @default(now())
  order       Order     @relation(fields: [orderId], references: [id])
  customer    User      @relation(fields: [customerId], references: [id])
}

model Dispute {
  id         String        @id @default(uuid()) @db.Uuid
  orderId    String        @unique @db.Uuid
  openedById String        @db.Uuid
  reason     String
  details    String
  status     DisputeStatus @default(OPEN)
  resolution String?
  evidence   Json?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  order      Order         @relation(fields: [orderId], references: [id])
  openedBy   User          @relation("DisputeOpenedBy", fields: [openedById], references: [id])
}

model WholesaleOffer {
  id           String            @id @default(uuid()) @db.Uuid
  sellerId     String            @db.Uuid
  title        String
  description  String
  minimumOrder Int
  active       Boolean           @default(true)
  seller       Business          @relation("WholesaleSeller", fields: [sellerId], references: [id])
  access       WholesaleAccess[]
}

model WholesaleAccess {
  id         String         @id @default(uuid()) @db.Uuid
  offerId    String         @db.Uuid
  buyerId    String         @db.Uuid
  approvedAt DateTime?
  invitedAt  DateTime       @default(now())
  offer      WholesaleOffer @relation(fields: [offerId], references: [id], onDelete: Cascade)
  buyer      Business       @relation("WholesaleBuyer", fields: [buyerId], references: [id])

  @@unique([offerId, buyerId])
}

model LoyaltyProgram {
  id              String           @id @default(uuid()) @db.Uuid
  businessId      String           @db.Uuid
  name            String
  pointsPerDollar Int              @default(1)
  active          Boolean          @default(true)
  business        Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  accounts        LoyaltyAccount[]
  vouchers        Voucher[]
  referrals       Referral[]
}

model LoyaltyAccount {
  id         String         @id @default(uuid()) @db.Uuid
  programId  String         @db.Uuid
  customerId String         @db.Uuid
  points     Int            @default(0)
  program    LoyaltyProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  customer   User           @relation(fields: [customerId], references: [id])

  @@unique([programId, customerId])
}

model Voucher {
  id              String         @id @default(uuid()) @db.Uuid
  programId       String         @db.Uuid
  code            String         @unique
  discountPercent Int
  expiresAt       DateTime
  maxUses         Int?
  uses            Int            @default(0)
  program         LoyaltyProgram @relation(fields: [programId], references: [id])
}

model ProductPrice {
  id        String  @id @default(uuid()) @db.Uuid
  productId String  @db.Uuid
  currency  String  @db.Char(3)
  amount    Decimal @db.Decimal(12, 2)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, currency])
}

model BusinessCurrency {
  id         String   @id @default(uuid()) @db.Uuid
  businessId String   @db.Uuid
  currency   String   @db.Char(3)
  active     Boolean  @default(true)
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, currency])
}

model Recipient {
  id      String @id @default(uuid()) @db.Uuid
  orderId String @unique @db.Uuid
  buyerId String @db.Uuid
  name    String
  phone   String
  address String
  city    String
  order   Order  @relation(fields: [orderId], references: [id])
  buyer   User   @relation(fields: [buyerId], references: [id])
}

model Invoice {
  id       String   @id @default(uuid()) @db.Uuid
  orderId  String   @unique @db.Uuid
  number   String   @unique
  type     String
  snapshot Json
  issuedAt DateTime @default(now())
  order    Order    @relation(fields: [orderId], references: [id])
}

model ProductFollow {
  id              String   @id @default(uuid()) @db.Uuid
  customerId      String   @db.Uuid
  productId       String   @db.Uuid
  lastPrice       Decimal? @db.Decimal(12, 2)
  notifyRestock   Boolean  @default(true)
  notifyPriceDrop Boolean  @default(true)
  customer        User     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([customerId, productId])
}

model Reservation {
  id         String            @id @default(uuid()) @db.Uuid
  customerId String            @db.Uuid
  productId  String            @db.Uuid
  branchId   String            @db.Uuid
  quantity   Int
  status     ReservationStatus @default(ACTIVE)
  expiresAt  DateTime
  customer   User              @relation(fields: [customerId], references: [id])
  product    Product           @relation(fields: [productId], references: [id])
  branch     Branch            @relation(fields: [branchId], references: [id])

  @@index([expiresAt, status])
}

model BusinessSubscription {
  id               String             @id @default(uuid()) @db.Uuid
  businessId       String             @unique @db.Uuid
  plan             SubscriptionPlan   @default(FREE)
  status           SubscriptionStatus @default(ACTIVE)
  currentPeriodEnd DateTime?
  business         Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model SearchEvent {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String?  @db.Uuid
  query       String
  category    String?
  city        String?
  province    String?
  resultCount Int
  createdAt   DateTime @default(now())
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt, city])
}

model SupportTicket {
  id         String       @id @default(uuid()) @db.Uuid
  userId     String       @db.Uuid
  businessId String?      @db.Uuid
  category   String
  subject    String
  details    String
  status     ReportStatus @default(OPEN)
  evidence   Json?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  user       User         @relation(fields: [userId], references: [id])
  business   Business?    @relation(fields: [businessId], references: [id])
}

model RefundRequest {
  id           String       @id @default(uuid()) @db.Uuid
  orderId      String       @db.Uuid
  businessId   String       @db.Uuid
  requesterId  String       @db.Uuid
  amount       Decimal      @db.Decimal(12, 2)
  currency     String       @db.Char(3)
  reason       String
  status       RefundStatus @default(REQUESTED)
  reviewedById String?      @db.Uuid
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  order        Order        @relation(fields: [orderId], references: [id])
  business     Business     @relation(fields: [businessId], references: [id])
  requester    User         @relation("RefundRequester", fields: [requesterId], references: [id])

  @@index([businessId, status])
}

model CourierProfile {
  id          String              @id @default(uuid()) @db.Uuid
  userId      String              @unique @db.Uuid
  companyName String
  phone       String
  cities      String[]
  verified    Boolean             @default(false)
  active      Boolean             @default(true)
  user        User                @relation(fields: [userId], references: [id])
  businesses  CourierBusiness[]
  assignments CourierAssignment[]
}

model CourierBusiness {
  id         String         @id @default(uuid()) @db.Uuid
  courierId  String         @db.Uuid
  businessId String         @db.Uuid
  approvedAt DateTime?
  courier    CourierProfile @relation(fields: [courierId], references: [id], onDelete: Cascade)
  business   Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([courierId, businessId])
}

model CourierAssignment {
  id          String         @id @default(uuid()) @db.Uuid
  courierId   String         @db.Uuid
  deliveryId  String         @db.Uuid
  acceptedAt  DateTime?
  completedAt DateTime?
  courier     CourierProfile @relation(fields: [courierId], references: [id])
  delivery    Delivery       @relation(fields: [deliveryId], references: [id])

  @@unique([courierId, deliveryId])
}

model FraudSignal {
  id         String        @id @default(uuid()) @db.Uuid
  userId     String?       @db.Uuid
  businessId String?       @db.Uuid
  type       String
  severity   FraudSeverity
  score      Int
  details    Json
  resolvedAt DateTime?
  createdAt  DateTime      @default(now())
  user       User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([severity, resolvedAt, createdAt])
}

model Referral {
  id           String         @id @default(uuid()) @db.Uuid
  programId    String         @db.Uuid
  referrerId   String         @db.Uuid
  referredId   String?        @db.Uuid
  code         String         @unique
  rewardPoints Int
  claimedAt    DateTime?
  createdAt    DateTime       @default(now())
  program      LoyaltyProgram @relation(fields: [programId], references: [id])
  referrer     User           @relation("ReferralReferrer", fields: [referrerId], references: [id])
  referred     User?          @relation("ReferralReferred", fields: [referredId], references: [id])
}

model NotificationOutbox {
  id        String    @id @default(uuid()) @db.Uuid
  channel   String
  recipient String
  template  String
  payload   Json
  status    String    @default("DELIVERED_DEMO")
  createdAt DateTime  @default(now())
  readAt    DateTime?

  @@index([channel, createdAt])
}

model ProviderEvent {
  id        String   @id @default(uuid()) @db.Uuid
  provider  String
  operation String
  status    String
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([provider, createdAt])
}
